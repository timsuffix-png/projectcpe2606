{
  "name": "gateway_temp",
  "version": "0.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "description": "Gateway application for temperature monitoring with Electron.js",
  "author": "Thanya",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "electron-forge start",
    "lint": "next lint",
    "e": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run build:electron && npm run start:electron\"",
    "builder": "npm run build && electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json -w",
    "start:electron": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "export": "next build"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "electron-squirrel-startup": "^1.0.1",
    "moment": "^2.30.1",
    "next": "15.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-gauge-chart": "^0.5.1",
    "react-select": "^5.10.1",
    "recharts": "^3.1.1",
    "serialport": "^13.0.0",
    "sweetalert2": "^11.22.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-gauge-chart": "^0.4.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  }
}
